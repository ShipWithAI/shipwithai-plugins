      "id": "pr-review",
      "name": "pr-review",
      "description": "Reviews pull requests against coding standards and CLAUDE.md conventions",
      "model": "sonnet",
      "tools": ["Read", "Bash", "Glob", "Grep"],
      "contextType": "task-specific",
      "selfDiscovers": ["CLAUDE.md"],
      "expects": [
        "PR_NUMBER or branch name — the PR or branch to review",
        "Pass as: 'Review PR #42' or 'Review branch feature/foo'"
      ],
      "alwaysInclude": false,
      "suggestWhen": {
        "files": [".github/", ".github/workflows/"],
        "context": ["teamSize > 2"]
      }
    },
    {
