          "matcher": "Edit",
          "hooks": [{"type": "command", "command": "case \"$CLAUDE_TOOL_INPUT_PATH\" in *.ts|*.tsx|*.js|*.jsx|*.md|*.json) deno fmt \"$CLAUDE_TOOL_INPUT_PATH\";; esac"}]
        }]
      }
    },
    {
      "id": "swiftformat-on-edit",
      "description": "Auto-format Swift files after edit",
      "requires": "swiftformat",
      "detectBy": {
        "files": [".swiftformat", "Package.swift"],
