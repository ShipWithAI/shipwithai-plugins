          "hooks": [{"type": "command", "command": "case \"$CLAUDE_TOOL_INPUT_PATH\" in *.js|*.ts|*.jsx|*.tsx|*.json) npx @biomejs/biome check --fix \"$CLAUDE_TOOL_INPUT_PATH\";; esac"}]
        }]
      }
    },
    {
      "id": "mypy-on-edit",
      "description": "Run mypy type check on Python files after edit",
      "requires": "mypy",
      "detectBy": {
