      },
      "hook": {
        "PostToolUse": [{
          "matcher": "Edit",
          "hooks": [{"type": "command", "command": "case \"$CLAUDE_TOOL_INPUT_PATH\" in *.py) ruff check --fix \"$CLAUDE_TOOL_INPUT_PATH\";; esac"}]
        }]
      }
    },
    {
      "id": "gofmt-on-edit",
      "description": "Auto-format Go files after edit",
      "requires": "gofmt",
      "detectBy": {
        "files": ["go.mod"],
        "packageJson": [],
        "binary": "gofmt"
      },
      "hook": {
        "PostToolUse": [{
          "matcher": "Edit",
          "hooks": [{"type": "command", "command": "case \"$CLAUDE_TOOL_INPUT_PATH\" in *.go) gofmt -w \"$CLAUDE_TOOL_INPUT_PATH\";; esac"}]
        }]
      }
    },
    {
      "id": "rustfmt-on-edit",
      "description": "Auto-format Rust files after edit",
      "requires": "rustfmt",
      "detectBy": {
        "files": ["Cargo.toml", "rustfmt.toml", ".rustfmt.toml"],
        "packageJson": [],
        "binary": "rustfmt"
      },
      "hook": {
        "PostToolUse": [{
          "matcher": "Edit",
          "hooks": [{"type": "command", "command": "case \"$CLAUDE_TOOL_INPUT_PATH\" in *.rs) rustfmt \"$CLAUDE_TOOL_INPUT_PATH\";; esac"}]
        }]
      }
    },
    {
      "id": "jest-on-stop",
      "description": "Run Jest test suite when Claude finishes a session",
      "requires": "jest",
      "detectBy": {
        "files": ["jest.config.*", "jest.config.js", "jest.config.ts"],
        "packageJson": ["devDependencies.jest", "dependencies.jest"],
        "binary": "jest"
      },
      "hook": {
        "Stop": [{"hooks": [{"type": "command", "command": "npm test"}]}]
      }
    },
    {
      "id": "pytest-on-stop",
      "description": "Run pytest when Claude finishes a session",
      "requires": "pytest",
      "detectBy": {
        "files": ["pytest.ini", "conftest.py"],
        "packageJson": [],
        "binary": "pytest"
      },
      "hook": {
        "Stop": [{"hooks": [{"type": "command", "command": "pytest"}]}]
      }
    },
    {
      "id": "make-test-on-stop",
      "description": "Run make test when Claude finishes a session",
      "requires": "make",
      "detectBy": {
        "files": ["Makefile"],
        "packageJson": [],
        "binary": "make"
      },
      "hook": {
        "Stop": [{"hooks": [{"type": "command", "command": "make test"}]}]
      }
    },
    {
      "id": "cargo-test-on-stop",
      "description": "Run cargo test when Claude finishes a session",
      "requires": "cargo",
      "detectBy": {
        "files": ["Cargo.toml"],
        "packageJson": [],
        "binary": "cargo"
      },
      "hook": {
        "Stop": [{"hooks": [{"type": "command", "command": "cargo test"}]}]
      }
    },
    {
      "id": "observability",
      "description": "Log tool call metadata (relative file path, command name) to .claude/logs/ for harness optimization",
      "requires": "python3",
      "detectBy": {
        "files": [],
        "packageJson": [],
        "binary": "python3"
      },
      "hook": {
        "PostToolUse": [{
          "matcher": "Edit|Write|Bash",
          "hooks": [{"type": "command", "command": "python3 .claude/hooks/observe.py"}]
        }],
        "Stop": [{
          "hooks": [{"type": "command", "command": "find .claude/logs -name '*.jsonl' -mtime +30 -delete 2>/dev/null || true"}]
        }]
      }
    },
    {
      "id": "biome-on-edit",
