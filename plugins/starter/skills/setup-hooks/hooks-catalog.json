{
  "schema": "1.2",
  "catalog": [
    {
      "id": "prettier-on-edit",
      "description": "Auto-format JS/TS/CSS/MD files after Claude edits them",
      "requires": "prettier",
      "detectBy": {
        "files": ["prettier.config.*", ".prettierrc*", ".prettierrc.js", ".prettierrc.json"],
        "packageJson": ["devDependencies.prettier", "dependencies.prettier"],
        "binary": "prettier"
      },
      "hook": {
        "PostToolUse": [{
          "matcher": "Edit",
          "hooks": [{"type": "command", "command": "case \"$CLAUDE_TOOL_INPUT_PATH\" in *.js|*.ts|*.jsx|*.tsx|*.css|*.md) npx prettier --write \"$CLAUDE_TOOL_INPUT_PATH\";; esac"}]
        }]
      }
    },
    {
      "id": "eslint-fix-on-edit",
      "description": "Auto-fix ESLint issues after Claude edits JS/TS files",
      "requires": "eslint",
      "detectBy": {
        "files": [".eslintrc*", "eslint.config.*", ".eslintrc.js", ".eslintrc.json"],
        "packageJson": ["devDependencies.eslint", "dependencies.eslint"],
        "binary": "eslint"
      },
      "hook": {
        "PostToolUse": [{
          "matcher": "Edit",
          "hooks": [{"type": "command", "command": "case \"$CLAUDE_TOOL_INPUT_PATH\" in *.js|*.ts|*.jsx|*.tsx) npx eslint --fix \"$CLAUDE_TOOL_INPUT_PATH\";; esac"}]
        }]
      }
    },
    {
      "id": "black-on-edit",
      "description": "Auto-format Python files with Black after edit",
      "requires": "black",
      "detectBy": {
        "files": [".black", "setup.cfg"],
        "packageJson": [],
        "binary": "black"
      },
      "hook": {
        "PostToolUse": [{
          "matcher": "Edit",
          "hooks": [{"type": "command", "command": "case \"$CLAUDE_TOOL_INPUT_PATH\" in *.py) black \"$CLAUDE_TOOL_INPUT_PATH\";; esac"}]
        }]
      }
    },
    {
      "id": "ruff-on-edit",
      "description": "Auto-lint and fix Python files with Ruff after edit",
      "requires": "ruff",
      "detectBy": {
        "files": ["ruff.toml", ".ruff.toml"],
        "packageJson": [],
