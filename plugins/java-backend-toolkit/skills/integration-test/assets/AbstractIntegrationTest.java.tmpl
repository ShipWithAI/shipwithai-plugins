package {{PACKAGE}};

import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.testcontainers.service.connection.ServiceConnection;
import org.testcontainers.containers.PostgreSQLContainer;
import org.testcontainers.junit.jupiter.Container;
import org.testcontainers.junit.jupiter.Testcontainers;

/**
 * Base for integration tests that run against REAL infrastructure via Testcontainers —
 * a throwaway Postgres, not H2 or mocks, so tests exercise the actual SQL dialect,
 * constraints, and Flyway/Liquibase migrations.
 *
 * {@code @ServiceConnection} (Spring Boot 3.1+) wires the container's JDBC url and
 * credentials into the context automatically — no {@code @DynamicPropertySource} needed.
 * The container is {@code static}, so it starts once and is shared by every subclass.
 */
@SpringBootTest
@Testcontainers
public abstract class AbstractIntegrationTest {

    @Container
    @ServiceConnection
    static final PostgreSQLContainer<?> POSTGRES = new PostgreSQLContainer<>("postgres:16");

    // Optional — a Kafka broker for event-driven tests (add org.testcontainers:kafka):
    // @Container @ServiceConnection
    // static final KafkaContainer KAFKA =
    //     new KafkaContainer(DockerImageName.parse("confluentinc/cp-kafka:7.6.1"));
}
