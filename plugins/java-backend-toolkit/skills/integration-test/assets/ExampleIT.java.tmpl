import java.time.Duration;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;

/**
 * Example integration test. Named {@code *IT} so Maven Failsafe / the Gradle
 * integrationTest task runs it; it boots the full context against the shared
 * Testcontainers Postgres from {@link AbstractIntegrationTest}.
 */
class {{ENTITY}}IT extends AbstractIntegrationTest {

    @Autowired
    private {{ENTITY}}Repository repository;

    @Test
    void persistsAndReadsBackFromRealPostgres() {
        // {{ENTITY}} saved = repository.save(new {{ENTITY}}(...));
        // assertThat(repository.findById(saved.getId())).isPresent();
    }

    @Test
    void asyncWorkEventuallyCompletes() {
        // Trigger async work, then POLL for the result with Awaitility.
        // Never Thread.sleep(...) — it is flaky and slow (rule test-thread-sleep).
        await().atMost(Duration.ofSeconds(5))
                .pollInterval(Duration.ofMillis(100))
                .untilAsserted(() -> assertThat(repository.count()).isEqualTo(1L));
    }
}
