        when(service.getById(1L)).thenReturn(/* a {{ENTITY}}Response */ null);
        mockMvc.perform(get("/api/{{ENTITY_LOWER}}s/1"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.id").value(1));
