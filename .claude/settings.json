{
  "permissions": {
    "allow": [
      "Read", "Write", "Edit", "Grep", "Glob",
      "Bash(git status*)", "Bash(git log*)", "Bash(git diff*)",
      "Bash(git add*)", "Bash(git commit*)", "Bash(git checkout*)",
      "Bash(git branch*)", "Bash(git fetch*)", "Bash(git pull*)",
      "Bash(git merge*)", "Bash(git tag*)", "Bash(git stash*)",
      "Bash(find *)", "Bash(ls *)", "Bash(cat *)",
      "Bash(python3 *)", "Bash(echo *)", "Bash(mkdir *)",
      "Bash(cp *)", "Bash(mv *)"
    ],
    "deny": [
      "Bash(rm -rf /)", "Bash(rm -rf ~)", "Bash(rm -rf /*)",
      "Bash(git push --force*)", "Bash(git push -f *)",
      "Bash(git reset --hard *)", "Bash(git commit *--no-verify*)",
      "Bash(nc -e*)", "Bash(nc -c*)",
      "Bash(*| bash)", "Bash(*|bash)", "Bash(*| sh)", "Bash(*|sh)",
      "Bash(base64 --decode*)", "Bash(base64 -d *)",
      "Bash(eval *)", "Bash(python* -c *)", "Bash(node -e *)",
      "Bash(npm publish*)", "Bash(chmod -R 777 *)", "Bash(sudo rm *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(scripts/publish-plugin.sh*)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "python3 .claude/hooks/validate-command.py"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{"type": "command", "command": "python3 .claude/hooks/protect-files.py"}]
      }
    ]
  }
}